# Copy this file to deploy/.env on the server. Do not commit deploy/.env.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public URL used while testing by IP. Change to https://your-domain after TLS is enabled.
CORS_ORIGINS=http://124.156.229.105
AUTH_COOKIE_SECURE=false

# Application security. Use unique long random values.
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
DATABASE_NAME=table_hub
DEBUG=false

# Add the existing provider / OSS / document-parsing settings below after securely
# copying the current local .env. Keep every secret in this untracked .env only.
# DASHSCOPE_API_KEY=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET_NAME=
