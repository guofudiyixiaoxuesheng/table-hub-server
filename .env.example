APP_NAME=Table Hub API
APP_ENV=development
DEBUG=false

# PostgreSQL（本地示例端口为 5433）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/table_hub

# 登录服务签发的 JWT 必须包含：sub、store_id、role、exp
# 生产环境请使用随机生成且不少于 32 字节的密钥。
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=table-hub-server
JWT_AUDIENCE=table-hub-web
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=.example.com

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://192.168.1.116:3000

# AI 模型配置
# LLM_PROVIDER=qwen 表示聊天、意图识别、RAG生成、运营物料等文本模型统一走阿里百炼兼容接口。
# 如果要切 DeepSeek，只需要改成 deepseek 并配置 DEEPSEEK_API_KEY。
LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 多模态图片理解模型；建议使用支持图片输入的千问 Omni/VL 模型。
QWEN_VISION_MODEL=qwen3.5-omni-plus

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 向量化 / 精排
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
RERANK_ENABLED=true
RERANK_MODEL=qwen3-rerank
RERANK_API_URL=
RERANK_TOP_N=5
RERANK_MIN_SCORE=0.2

# AI 效果评估
EVALUATION_MODEL=qwen-plus
EVALUATION_MAX_TOKENS=8192
EVALUATION_RETRY_MAX_TOKENS=16384

# 图片生成。省钱模式默认关闭；需要真实生图时改为 qwen。
IMAGE_GENERATION_PROVIDER=disabled
# 提示词调试阶段保持 true；确认 Prompt 后改为 false 才会真实调用生图。
IMAGE_GENERATION_DRY_RUN=true
QWEN_IMAGE_MODEL=qwen-image-3.0
# QWEN_IMAGE_MODEL=qwen-image-3.0-pro
QWEN_IMAGE_SIZE=1024*1024
QWEN_IMAGE_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
QWEN_IMAGE_TASK_URL=https://dashscope.aliyuncs.com/api/v1/tasks
QWEN_IMAGE_POLL_INTERVAL_SECONDS=2
QWEN_IMAGE_POLL_TIMEOUT_SECONDS=120

# 阿里云 OSS。生产环境建议使用 RAM 子账号或 STS，不要使用主账号 AccessKey。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# 可选：已公开的 OSS Bucket 或 CDN 域名，例如 https://static.example.com。
# 配置后图片 API 返回稳定地址；私有 Bucket 留空时，API 会在每次读取时重新签发短期地址。
OSS_PUBLIC_BASE_URL=
OSS_PRESIGN_EXPIRES_SECONDS=900
OSS_MAX_FILES_PER_PACKAGE=500
OSS_MAX_PACKAGE_SIZE_BYTES=2147483648
