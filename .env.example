APP_NAME=Table Hub API
APP_ENV=development
DEBUG=false

# PostgreSQL（本地示例端口为 5433）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/table_hub

# 登录服务签发的 JWT 必须包含：sub、store_id、role、exp
# 生产环境请使用随机生成且不少于 32 字节的密钥。
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=table-hub-server
JWT_AUDIENCE=table-hub-web
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=.example.com

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://192.168.1.116:3000

# 阿里云 OSS。生产环境建议使用 RAM 子账号或 STS，不要使用主账号 AccessKey。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_PRESIGN_EXPIRES_SECONDS=900
OSS_MAX_FILES_PER_PACKAGE=500
OSS_MAX_PACKAGE_SIZE_BYTES=2147483648
